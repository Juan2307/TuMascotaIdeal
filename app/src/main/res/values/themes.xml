<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Flashlight" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="SinActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#B83270</item>
        <item name="colorPrimaryVariant">#84204F</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#00796B</item>
        <item name="colorSecondaryVariant">#00574B</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#252128</item>
        <item name="android:colorBackground">#FAF7F9</item>
        <item name="android:statusBarColor">#84204F</item>
        <item name="android:navigationBarColor">#FAF7F9</item>
    </style>

    <style name="ConActionBar" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">#B83270</item>
        <item name="colorPrimaryVariant">#84204F</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#00796B</item>
        <item name="colorSecondaryVariant">#00574B</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#252128</item>
        <item name="android:colorBackground">#FAF7F9</item>
        <item name="android:statusBarColor">#84204F</item>
        <item name="android:navigationBarColor">#FAF7F9</item>
    </style>


    <!-- Menu Style-->
    <style name="navigationTheme">
        <!-- Color of text and icon when SELECTED-->
        <item name="colorPrimary">@color/pink</item>
        <!-- Background color when SELECTED-->
        <item name="colorControlHighlight">@color/colorAccent2</item>
    </style>

</resources>